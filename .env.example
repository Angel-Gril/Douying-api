# Optional Douyin web cookie. Keep this value local and never commit it.
DOUYIN_COOKIE=

# Optional native page/API cookies; leave empty for public content.
XHS_COOKIE=
BILIBILI_COOKIE=

# Server-side fallback adapter configuration.
BUGPK_API_BASE_URL=https://api-new.ifphp.com
BUGPK_API_KEY=

# Optional FFmpeg executable. The imageio-ffmpeg wheel provides a default binary.
FFMPEG_PATH=

# Optional additional media hostnames controlled/trusted by the service operator.
# This is server configuration, never a client supplied allowlist.
MEDIA_EXTRA_HOSTS=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8848,http://127.0.0.1:8848

# Enable expensive diagnostic endpoints only for local troubleshooting.
ENABLE_DEBUG_ENDPOINTS=0
